rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Votos sem nome: qualquer pessoa lê, para mostrar o resultado. Cada conta anônima cria um único voto, que não muda.
    match /votos/{uid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['modelo', 'criadoEm'])
        && request.resource.data.keys().hasAll(['modelo', 'criadoEm'])
        && request.resource.data.modelo in ['assinatura', 'simbolo-gigante', 'padrao', 'organismo', 'colmeia']
        && request.resource.data.criadoEm == request.time
        && existsAfter(/databases/$(database)/documents/nomes/$(uid));
      allow update, delete: if false;
    }

    // Nomes: ninguém lê pela página. Só quem administra o projeto vê, no console do Firebase.
    match /nomes/{uid} {
      allow read: if false;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'modelo'])
        && request.resource.data.keys().hasAll(['nome', 'modelo'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 60
        && existsAfter(/databases/$(database)/documents/votos/$(uid))
        && getAfter(/databases/$(database)/documents/votos/$(uid)).data.modelo == request.resource.data.modelo;
      allow update, delete: if false;
    }
  }
}
